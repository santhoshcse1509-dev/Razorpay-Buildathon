# Database connection string (PostgreSQL for production, file:./dev.db for local SQLite development)
DATABASE_URL="file:./dev.db"

# Server configuration
PORT=3000
NODE_ENV="development"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Anthropic Claude AI API (Claude 3.7 / Claude 3.5 Sonnet / claude-sonnet-4-6)
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxx"

# Razorpay Test / Production Payment Gateway Keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
